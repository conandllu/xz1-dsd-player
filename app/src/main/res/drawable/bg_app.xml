<?xml version="1.0" encoding="utf-8"?>
<!-- 深色渐变底（gradient 必须是 shape 的子元素，不能单独作根） -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <gradient
        android:angle="270"
        android:centerColor="#123039"
        android:endColor="#0A1016"
        android:startColor="#0D1B22"
        android:type="linear" />
</shape>
