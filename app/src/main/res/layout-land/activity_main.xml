<?xml version="1.0" encoding="utf-8"?>
<!-- 横屏布局：左侧 NavigationRail（走查 L6）+ 右侧内容列；迷你条限宽居中（L5） -->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_app">

    <!-- 左侧导航 rail（替代底部胶囊） -->
    <LinearLayout
        android:id="@+id/bottomNav"
        android:layout_width="78dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_nav_pill"
        android:gravity="center_horizontal|top"
        android:orientation="vertical"
        android:paddingVertical="8dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <LinearLayout
            android:id="@+id/navLibrary"
            android:layout_width="62dp"
            android:layout_height="62dp"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/navLibraryIcon"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:contentDescription="@string/lib_title"
                android:src="@drawable/ic_library"
                app:tint="#FFFFFFFF" />

            <TextView
                android:id="@+id/navLibraryText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/lib_title"
                android:textColor="#FFFFFFFF"
                android:textSize="10sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/navFolders"
            android:layout_width="62dp"
            android:layout_height="62dp"
            android:layout_marginTop="4dp"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/navFoldersIcon"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:contentDescription="@string/lib_folder"
                android:src="@drawable/ic_folder"
                app:tint="#99FFFFFF" />

            <TextView
                android:id="@+id/navFoldersText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/lib_folder"
                android:textColor="#99FFFFFF"
                android:textSize="10sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/navPlayer"
            android:layout_width="62dp"
            android:layout_height="62dp"
            android:layout_marginTop="4dp"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/navPlayerIcon"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:contentDescription="@string/now_playing"
                android:src="@drawable/ic_play_circle"
                app:tint="#99FFFFFF" />

            <TextView
                android:id="@+id/navPlayerText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/now_playing"
                android:textColor="#99FFFFFF"
                android:textSize="10sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/navSettings"
            android:layout_width="62dp"
            android:layout_height="62dp"
            android:layout_marginTop="4dp"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/navSettingsIcon"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:contentDescription="@string/settings"
                android:src="@drawable/ic_settings"
                app:tint="#99FFFFFF" />

            <TextView
                android:id="@+id/navSettingsText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/settings"
                android:textColor="#99FFFFFF"
                android:textSize="10sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- 标题行：横屏压扁（走查 L7） -->
    <LinearLayout
        android:id="@+id/titleRow"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="6dp"
        android:paddingTop="4dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toEndOf="@id/bottomNav"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginEnd="4dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/nav_back"
            android:padding="8dp"
            android:src="@drawable/ic_back"
            android:visibility="gone"
            app:tint="#FFFFFF" />

        <TextView
            android:id="@+id/pageTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:singleLine="true"
            android:text="@string/lib_title"
            android:textColor="#FFFFFFFF"
            android:textSize="20sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/btnSearch"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/search"
            android:padding="9dp"
            android:src="@drawable/ic_search"
            app:tint="#FFFFFF" />

        <ImageView
            android:id="@+id/btnSort"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/sort_layout"
            android:padding="9dp"
            android:src="@drawable/ic_sort"
            app:tint="#CCFFFFFF" />
    </LinearLayout>

    <TextView
        android:id="@+id/pageSubtitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:paddingHorizontal="16dp"
        android:textColor="#99FFFFFF"
        android:textSize="11sp"
        app:layout_constraintTop_toBottomOf="@id/titleRow"
        app:layout_constraintStart_toEndOf="@id/bottomNav"
        app:layout_constraintEnd_toEndOf="parent" />

    <FrameLayout
        android:id="@+id/pageHost"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/pageSubtitle"
        app:layout_constraintBottom_toTopOf="@id/miniPlayer"
        app:layout_constraintStart_toEndOf="@id/bottomNav"
        app:layout_constraintEnd_toEndOf="parent" />

    <LinearLayout
        android:id="@+id/miniPlayer"
        android:layout_width="0dp"
        android:layout_height="58dp"
        android:layout_marginBottom="14dp"
        android:background="@drawable/bg_mini_player"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="8dp"
        app:layout_constraintWidth_max="600dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@id/bottomNav"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.5">

        <com.dsd.player.ui.CoverImageView
            android:id="@+id/miniCover"
            app:radiusDp="8"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="@drawable/bg_cover_placeholder"
            android:contentDescription="@string/artwork"
            android:scaleType="centerCrop" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/miniTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="marquee"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:marqueeRepeatLimit="marquee_forever"
                android:singleLine="true"
                android:text="@string/nothing_playing"
                android:textColor="#FFFFFFFF"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/miniSubtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:singleLine="true"
                android:textColor="#99FFFFFF"
                android:textSize="10sp" />
        </LinearLayout>

        <ImageView
            android:id="@+id/miniPrev"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/prev"
            android:padding="9dp"
            android:src="@drawable/ic_prev"
            app:tint="#FFFFFF" />

        <ImageView
            android:id="@+id/miniPlay"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/play"
            android:padding="10dp"
            android:src="@drawable/ic_play"
            app:tint="#FFFFFF" />

        <ImageView
            android:id="@+id/miniNext"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/next"
            android:padding="10dp"
            android:src="@drawable/ic_next"
            app:tint="#FFFFFF" />
    </LinearLayout>

    <View
        android:id="@+id/miniProgressBg"
        android:layout_width="0dp"
        android:layout_height="2dp"
        android:layout_marginHorizontal="18dp"
        android:layout_marginBottom="4dp"
        android:background="#1FFFFFFF"
        app:layout_constraintBottom_toBottomOf="@id/miniPlayer"
        app:layout_constraintStart_toStartOf="@id/miniPlayer"
        app:layout_constraintEnd_toEndOf="@id/miniPlayer" />

    <View
        android:id="@+id/miniProgress"
        android:layout_width="0dp"
        android:layout_height="2dp"
        android:background="#5B8DEF"
        app:layout_constraintBottom_toBottomOf="@id/miniProgressBg"
        app:layout_constraintStart_toStartOf="@id/miniProgressBg" />
</androidx.constraintlayout.widget.ConstraintLayout>
