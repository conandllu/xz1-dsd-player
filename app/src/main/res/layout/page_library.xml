<?xml version="1.0" encoding="utf-8"?>
<!--
  音乐库（本地 + Qobuz 在线合为一体）
  ─────────────────────────────────────
  从上到下：搜索框 → 来源（本地/在线）→ 分类 chips → 在线状态条（仅在线）→ 内容
  设计约束：来源与分类都用同一套胶囊 chip；在线专辑卡片与本地专辑卡片复用同一个
  item_album_grid.xml —— 两个来源在视觉上完全一致，只是数据来源不同。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- 搜索框：默认隐藏，由顶栏搜索图标展开（和排序/布局按钮并排，见 ui-layout-review） -->
    <LinearLayout
        android:id="@+id/searchBar"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:layout_marginHorizontal="12dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_chip"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_marginStart="14dp"
            android:contentDescription="@string/search"
            android:src="@drawable/ic_search"
            app:tint="#66FFFFFF" />

        <EditText
            android:id="@+id/searchInput"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@null"
            android:hint="@string/search_hint"
            android:imeOptions="actionSearch"
            android:inputType="text"
            android:paddingHorizontal="10dp"
            android:singleLine="true"
            android:textColor="#FFFFFFFF"
            android:textColorHint="#66FFFFFF"
            android:textSize="13sp" />

        <ImageView
            android:id="@+id/searchClear"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="清除"
            android:padding="7dp"
            android:src="@drawable/ic_clear"
            android:visibility="gone"
            app:tint="#66FFFFFF" />

        <TextView
            android:id="@+id/searchAction"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:background="@drawable/bg_chip_active"
            android:gravity="center"
            android:paddingHorizontal="16dp"
            android:text="@string/search"
            android:textColor="#FFFFFFFF"
            android:textSize="12sp"
            android:visibility="gone" />
    </LinearLayout>

    <!-- 来源：本地曲库 / Qobuz 在线（右侧只在未登录时给一个「登录」动作，不显示登录状态） -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <HorizontalScrollView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:paddingStart="12dp"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/sourceRow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal" />
        </HorizontalScrollView>

        <TextView
            android:id="@+id/qbLoginBtn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="12dp"
            android:background="@drawable/bg_chip_active"
            android:paddingHorizontal="14dp"
            android:paddingVertical="6dp"
            android:text="登录"
            android:textColor="#FFFFFFFF"
            android:textSize="12sp"
            android:visibility="gone" />
    </LinearLayout>

    <!-- 分类：本地（专辑/艺术家/歌曲/流派/年份）· 在线（收藏/专辑/曲目）
         最右侧的「从账号导入」与分类 chips 同一行（只在在线·收藏为空时出现） -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <HorizontalScrollView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:paddingStart="12dp"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/chipRow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal" />
        </HorizontalScrollView>

        <TextView
            android:id="@+id/favImportBtn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="12dp"
            android:background="@drawable/bg_chip"
            android:gravity="center"
            android:minHeight="48dp"
            android:paddingHorizontal="12dp"
            android:text="从账号导入"
            android:textColor="#CCFFFFFF"
            android:textSize="12sp"
            android:visibility="gone" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingHorizontal="12dp"
            android:paddingBottom="16dp" />

        <TextView
            android:id="@+id/empty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:padding="24dp"
            android:text="@string/empty_library"
            android:textColor="#99FFFFFF"
            android:visibility="gone" />
    </FrameLayout>
</LinearLayout>
