<?xml version="1.0" encoding="utf-8"?>
<!-- 列表形态的专辑行：左侧方形缩略图 + 右侧标题/副标题。
     之前列表形态复用网格布局、只把封面高度改成 52dp 而宽度 match_parent，
     结果渲染成"一条横贯屏幕的窄封面"（走查里被当成 bug）。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="10dp"
    android:paddingTop="8dp"
    android:paddingEnd="10dp"
    android:paddingBottom="8dp">

    <com.dsd.player.ui.CoverImageView
        android:id="@+id/cover"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:background="@drawable/bg_cover_placeholder"
        android:contentDescription="@string/artwork"
        app:radiusDp="10" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#FFFFFFFF"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#99FFFFFF"
            android:textSize="12sp" />
    </LinearLayout>
</LinearLayout>
